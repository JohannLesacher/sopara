{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run dev)",
      "Bash(npm run format:all:check)",
      "Bash(npm run translate)",
      "Bash(npx prettier:*)",
      "Bash(wp mcp-adapter:*)",
      "Bash(wp acorn:*)",
      "Bash(vendor/bin/pint:*)",
      "mcp__figma__get_design_context",
      "mcp__figma__get_screenshot",
      "mcp__figma__get_metadata",
      "mcp__figma__get_variable_defs",
      "mcp__figma__get_code_connect_map",
      "mcp__figma__whoami"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(chmod 777:*)",
      "Bash(chmod -R 777:*)",
      "Bash(mkfs:*)",
      "Bash(dd:*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(auth.json)",
      "Read(node_modules/**)",
      "Read(vendor/**/*.php)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-commit-secrets.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit-format.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "prompt",
            "prompt": "Hook input: $ARGUMENTS\n\nIf stop_hook_active is true, respond {\"ok\": true}. Otherwise: did Claude write or modify code (PHP, Blade, SCSS, JS, JSON config) in this turn and discover new patterns, design tokens, recurring errors or architectural decisions worth recording? If yes, respond {\"ok\": false, \"reason\": \"Update .claude/memory.md with the new discoveries if not already documented there (Key Facts, Learned patterns, or Recurring errors to avoid). Only append, never overwrite.\"}. Otherwise respond {\"ok\": true}."
          }
        ]
      }
    ]
  }
}
